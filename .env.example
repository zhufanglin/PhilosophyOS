# PhilosophyOS 本地后端配置示例
# 不要在这里填写真实密钥；复制为 apps/api/.env 或在本机 shell 中设置环境变量。

# 可选：配置后端 OpenAI provider。真实值只允许放在后端环境中，不能以 VITE_ 前缀暴露给浏览器。
OPENAI_API_KEY=

# 可选：Responses API 使用的模型。
OPENAI_MODEL=gpt-5.6

# 可选：auto 会在存在 OPENAI_API_KEY 时启用 OpenAI，否则使用 deterministic。
# 可选值：auto、openai、deterministic
PHILOSOPHYOS_AI_PROVIDER=auto
