# PhilosophyOS 本地后端配置示例
# 不要在这个示例文件中填写真实密钥；复制为 apps/api/.env 或在本机 shell 中设置环境变量。
# 真实 OpenAI API key 只能出现在后端环境中，不能使用 VITE_ 前缀暴露给浏览器。

# 可选：配置后端 OpenAI provider。真实值只允许放在后端环境中，不能以 VITE_ 前缀暴露给浏览器。
OPENAI_API_KEY=

# 可选：Responses API 使用的模型。
OPENAI_MODEL=gpt-5.6

# 可选：OpenAI-compatible 中转站地址。不填时使用官方默认地址。
# 示例：https://relay.example.com/v1
OPENAI_BASE_URL=

# 可选：API 调用风格。
# responses 适合 OpenAI Responses API；chat_completions 适合 DeepSeek 等兼容 Chat Completions 的服务。
# 可选值：responses、chat_completions
OPENAI_API_STYLE=responses

# 可选：选择当前使用哪套模型配置。
# free 使用 FREE_*（豆包/火山方舟）；gpt 使用 GPT_*，若未配置则兼容旧的 OPENAI_*；deepseek/qwen/kimi/zhipu/siliconflow 使用各自前缀。
# 可选值：free、gpt、deepseek、qwen、kimi、zhipu、siliconflow
PHILOSOPHYOS_MODEL_PROFILE=free

# 可选：免费默认模型配置。当前建议使用豆包/火山方舟免费额度。
FREE_API_KEY=
FREE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FREE_MODEL=doubao-seed-2-0-lite-260428
FREE_API_STYLE=responses

# 可选：GPT 独立配置。适合官方 OpenAI 或 GPT 中转站。
GPT_API_KEY=
GPT_BASE_URL=https://api.synapai.top/v1
GPT_MODEL=gpt-5.6
GPT_API_STYLE=responses

# 可选：DeepSeek 独立配置。Base URL 默认固定为官方地址；模型只建议二选一：
# deepseek-v4-flash 或 deepseek-v4-pro。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_STYLE=chat_completions

# 可选：通义千问 / 阿里百炼 OpenAI 兼容配置。
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_STYLE=chat_completions

# 可选：Kimi / 月之暗面 OpenAI 兼容配置。
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_STYLE=chat_completions

# 可选：智谱 GLM OpenAI 兼容配置。
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-plus
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_STYLE=chat_completions

# 可选：硅基流动 OpenAI 兼容配置。
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_STYLE=chat_completions

# 可选：auto 会在存在 OPENAI_API_KEY 时启用 OpenAI，否则使用 deterministic。
# 可选值：auto、openai、deterministic
PHILOSOPHYOS_AI_PROVIDER=auto

# 可选：前端本地开发时指向 FastAPI。它不是密钥，可以暴露给浏览器。
VITE_API_BASE_URL=http://127.0.0.1:8000

# 可选：Obsidian 草稿输出目录。前端不能传任意路径，只能由后端读取这个固定目录。
OBSIDIAN_DRAFTS_DIR=D:\Obsidian\storage\Stu的哲学思考\PhilosophyOS\草稿

# 可选：思想快照本地事件日志。默认写入 data/local/，该目录不会提交到 GitHub。
THOUGHT_SNAPSHOTS_PATH=data\local\thought-snapshots.jsonl
